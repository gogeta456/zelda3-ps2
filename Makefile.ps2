# zelda3 for PlayStation 2 (ps2dev + SDL2 port).  Usage:  source env.sh && make -f Makefile.ps2
EE_BIN = zelda3.elf
SRCS := $(filter-out src/opengl.c src/glsl_shader.c, $(wildcard src/*.c snes/*.c)) \
        third_party/opus-1.3.1-stripped/opus_decoder_amalgam.c $(wildcard ps2/*.c)
EE_OBJS = $(SRCS:.c=.o) ps2/save_icon.o ps2/audsrv_embed.o
EE_INCS += -I. -I$(PS2SDK)/ports/include -I$(PS2SDK)/ports/include/SDL2 -I$(GSKIT)/include
# Debug info is off by default (the ELF is about 3 MB instead of about 12 MB); use  make -f Makefile.ps2 DBGINFO="-gdwarf-2 -gz"  to get it back.
EE_DBGINFOFLAGS = $(DBGINFO)
EE_LDFLAGS += $(if $(DBGINFO),,-s)
EE_CFLAGS += -MMD -MP -std=gnu11 -O2 -fno-strict-aliasing -DSYSTEM_VOLUME_MIXER_AVAILABLE=0 $(EXTRA_CFLAGS)
EE_LDFLAGS += -L$(PS2SDK)/ports/lib -L$(GSKIT)/lib -Wl,--defsym,_stack_size=0x40000
EE_LIBS += -lSDL2main -lSDL2 -lm -lps2_drivers -lpatches -lgskit -ldmakit -laudsrv
all: $(EE_BIN)
clean:
	rm -f $(EE_BIN) $(EE_OBJS) $(EE_OBJS:.o=.d)
	$(MAKE) -C ps2/iop/audsrv clean
ps2/save_icon.o: ps2/icon.sys ps2/zelda3.icn
ps2/audsrv_embed.o: ps2/iop/audsrv/audsrv.irx
ps2/iop/audsrv/audsrv.irx: $(wildcard ps2/iop/audsrv/src/*) ps2/iop/audsrv/Makefile
	$(MAKE) -C ps2/iop/audsrv

include $(PS2SDK)/samples/Makefile.pref
include $(PS2SDK)/samples/Makefile.eeglobal
-include $(EE_OBJS:.o=.d)
